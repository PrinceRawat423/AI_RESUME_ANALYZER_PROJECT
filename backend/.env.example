# Optional for local demo mode. Required to persist analyses and user accounts.
MONGODB_URI=mongodb://127.0.0.1:27017/ai_resume_analyzer

# Use a long, random value outside local development.
JWT_SECRET=replace-with-a-long-random-secret

# Optional. Enables Gemini-generated suggestions, interview questions, and chat.
# Without it, the app returns deterministic fallback guidance.
GEMINI_API_KEY=

PORT=5001
